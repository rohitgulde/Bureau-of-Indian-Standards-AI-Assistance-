# ─────────────────────────────────────────────────────────────
# BIS Knowledge Portal — Backend Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Google AI (required for RAG + embeddings) ─────────────────
GOOGLE_API_KEY=your-google-ai-api-key-here

# ── Gemini model selection ────────────────────────────────────
# Options: gemini-1.5-flash (default, fast)  |  gemini-1.5-pro  (higher quality)
GEMINI_MODEL=gemini-1.5-flash

# ── Bhashini / ULCA (Indian language AI) ─────────────────────
# Register at https://bhashini.gov.in to get these keys.
# Leave blank or set BHASHINI_MOCK=true to use offline mock mode.
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-ulca-api-key
BHASHINI_INFERENCE_KEY=your-bhashini-inference-key
# Set to true for local testing without Bhashini API keys:
BHASHINI_MOCK=true
BHASHINI_TIMEOUT=30

# ── Qdrant vector store ───────────────────────────────────────
# Leave QDRANT_HOST unset to use local in-process storage (no Docker needed)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
QDRANT_PATH=data/qdrant_storage

# ── SQLite database ───────────────────────────────────────────
# Default: app/database/bis_master.db  (relative to backend/)
# DATABASE_URL=sqlite:///./app/database/bis_master.db

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Ingestion tuning ──────────────────────────────────────────
EMBED_BATCH_SIZE=50

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to DEBUG to see SQL queries:  DB_ECHO=true
DB_ECHO=false